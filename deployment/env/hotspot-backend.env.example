# Hotspot Guard backend runtime environment
#
# Copy to /etc/thermoguard/hotspot-backend.env on the factory host.
# Do not commit the copied file. Keep owner/group and permissions as documented
# in deployment/FACTORY_RUNBOOK.ko.md.
# This file is DB-only; never add Dashboard or Telegram credentials here.

# MariaDB connection used by Project_hotspot/backend/database.py
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotspot_guard
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
