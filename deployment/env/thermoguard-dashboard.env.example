# ThermoGuard dashboard runtime environment
#
# Copy to /var/lib/thermoguard/dashboard.env on the factory host and keep it
# mode 0600.  The approved launcher exports THERMOGUARD_DASHBOARD_ENV to this
# persistent file outside the immutable release.  Do not commit the copy.

# Begin commissioning with delivery disabled.  Change to true only after a
# successful alert-delivery acceptance test has been recorded.
TELEGRAM_ENABLED=false
BOT_TOKEN=
CHAT_ID=

# Local FastAPI backend endpoint. Change only when the secured topology requires it.
FASTAPI_URL=http://127.0.0.1:8000
